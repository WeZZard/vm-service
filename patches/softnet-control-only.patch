+#[test]
+fn arp_ownership_targets_and_correlated_tentative_address() {
+    let mut p = policy();
+    let l = lease();
+    assert!(allowed(&mut p, &arp(false, VM, HOST), false, &l));
+    assert!(allowed(&mut p, &arp(true, HOST, VM), true, &l));
+    assert!(!allowed(
+        &mut p,
+        &arp(false, VM, Ipv4Address::new(8, 8, 8, 8)),
+        false,
+        &l
+    ));
+    let mut bad = arp(false, VM, HOST);
+    bad[22] = 4;
+    assert!(!allowed(&mut p, &bad, false, &l));
+    let mut bad = arp(false, VM, HOST);
+    bad[32] = 4;
+    assert!(!allowed(&mut p, &bad, false, &l));
+    let mut dad = arp(false, Ipv4Address::UNSPECIFIED, VM);
+    dad[..6].fill(255);
+    assert!(!allowed(&mut p, &dad, false, &None));
+    assert!(allowed(
+        &mut p,
+        &dhcp(false, &message(false, MessageType::Discover, 42)),
+        false,
+        &None
+    ));
+    assert!(allowed(
+        &mut p,
+        &dhcp(true, &message(true, MessageType::Offer, 42)),
+        true,
+        &None
+    ));
+    assert!(allowed(&mut p, &dad, false, &None));
+    let mut request = message(false, MessageType::Request, 42);
+    request
+        .opts_mut()
+        .insert(DhcpOption::ServerIdentifier(HOST));
+    assert!(allowed(&mut p, &dhcp(false, &request), false, &None));
+    assert!(allowed(
+        &mut p,
+        &dhcp(true, &message(true, MessageType::Ack, 42)),
+        true,
+        &None
+    ));
+    assert!(!allowed(&mut p, &dad, false, &None));
+}
