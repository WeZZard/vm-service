+#[test]
+fn reject_fragments_spoofing_and_unsupported_frames() {
+    let mut p = policy();
+    let l = lease();
+    for host in [false, true] {
+        for (more, offset) in [(true, 0), (false, 8)] {
+            let mut b = tcp(host, 22, true, false);
+            let mut ip = Ipv4Packet::new_unchecked(&mut b[14..]);
+            ip.set_more_frags(more);
+            ip.set_frag_offset(offset);
+            assert!(!allowed(&mut p, &b, host, &l));
+        }
+        for proto in [
+            EthernetProtocol::Ipv6,
+            EthernetProtocol::Unknown(0x8100),
+            EthernetProtocol::Unknown(0x88a8),
+        ] {
+            assert!(!allowed(&mut p, &frame(&[0; 48], host, proto), host, &l));
+        }
+        let mut b = tcp(host, 22, true, false);
+        Ipv4Packet::new_unchecked(&mut b[14..]).set_src_addr(Ipv4Address::new(169, 254, 169, 254));
+        assert!(!allowed(&mut p, &b, host, &l));
+        for idx in [0, 6] {
+            let mut b = tcp(host, 22, true, false);
+            b[idx] = 4;
+            assert!(!allowed(&mut p, &b, host, &l));
+        }
+        let mut b = tcp(host, 22, true, false);
+        b[..6].fill(255);
+        assert!(!allowed(&mut p, &b, host, &l));
+    }
