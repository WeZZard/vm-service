+#[test]
+fn bounded_connections_expiry_and_reset() {
+    let mut p = policy();
+    let l = lease();
+    let now = Instant::now();
+    for port in 1..=MAX_CONNECTIONS + 1 {
+        let mut b = tcp(true, 22, true, false);
+        TcpPacket::new_unchecked(&mut b[34..]).set_src_port(port as u16);
+        assert_eq!(
+            allowed_at(&mut p, &b, true, &l, now),
+            port <= MAX_CONNECTIONS
+        );
+    }
+    assert_eq!(p.connections.len(), MAX_CONNECTIONS);
+    let mut reply = tcp(false, 22, false, true);
+    TcpPacket::new_unchecked(&mut reply[34..]).set_dst_port(1);
+    assert!(allowed_at(
+        &mut p,
+        &reply,
+        false,
+        &l,
+        now + CONNECTION_TTL - Duration::from_secs(1)
+    ));
+    assert!(!allowed_at(&mut p, &reply, false, &l, now + CONNECTION_TTL));
+    assert!(p.connections.is_empty());
+    assert!(allowed_at(
+        &mut p,
+        &tcp(true, 22, true, false),
+        true,
+        &l,
+        now + CONNECTION_TTL
+    ));
+    let mut rst = tcp(false, 22, false, true);
+    TcpPacket::new_unchecked(&mut rst[34..]).set_rst(true);
+    assert!(allowed_at(&mut p, &rst, false, &l, now + CONNECTION_TTL));
+    assert!(!allowed_at(
+        &mut p,
+        &tcp(false, 22, false, true),
+        false,
+        &l,
+        now + CONNECTION_TTL
+    ));
+}
