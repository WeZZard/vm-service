+        &mut p,
+        &req,
+        false,
+        &None,
+        now + DHCP_TTL - Duration::from_secs(1)
+    ));
+    assert!(!allowed_at(
+        &mut p,
+        &dhcp(true, &message(true, MessageType::Ack, 42)),
+        true,
+        &None,
+        now + DHCP_TTL
+    ));
+    assert!(allowed_at(
+        &mut p,
+        &dhcp(false, &message(false, MessageType::Request, 43)),
