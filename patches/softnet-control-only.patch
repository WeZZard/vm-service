+#[test]
+fn dhcp_correlation_replay_and_reassignment() {
+    let mut p = policy();
+    let l = lease();
+    let request = dhcp(false, &message(false, MessageType::Request, 42));
+    let ack = dhcp(true, &message(true, MessageType::Ack, 42));
+    assert!(!allowed(&mut p, &ack, true, &l));
+    assert!(allowed(&mut p, &request, false, &l));
+    assert!(!allowed(
+        &mut p,
+        &dhcp(true, &message(true, MessageType::Ack, 43)),
+        true,
+        &l
+    ));
+    assert!(allowed(&mut p, &tcp(true, 22, true, false), true, &l));
+    assert!(allowed(&mut p, &ack, true, &l));
+    assert!(!allowed(&mut p, &tcp(false, 22, false, true), false, &l));
+    assert!(!allowed(&mut p, &ack, true, &l));
+    assert!(allowed(&mut p, &tcp(true, 22, true, false), true, &l));
+    let expired = Some(Lease::new(VM, Duration::ZERO, HashSet::new()));
+    assert!(!allowed(
+        &mut p,
+        &tcp(false, 22, false, true),
+        false,
+        &expired
+    ));
+    assert!(!allowed(&mut p, &tcp(false, 22, false, true), false, &l));
+}
+#[test]
+fn dhcp_subnet_server_identity_and_options() {
+    for addr in [
+        HOST,
+        Ipv4Address::new(192, 168, 64, 0),
+        Ipv4Address::new(192, 168, 64, 255),
+        Ipv4Address::new(10, 0, 0, 2),
+    ] {
+        let mut p = policy();
+        assert!(allowed(
+            &mut p,
+            &dhcp(false, &message(false, MessageType::Request, 42)),
+            false,
+            &None
+        ));
+        let mut m = message(true, MessageType::Ack, 42);
+        m.set_yiaddr(addr);
+        assert!(!allowed(&mut p, &dhcp(true, &m), true, &None));
+    }
+    for mutation in 0..5 {
+        let mut p = policy();
+        assert!(allowed(
+            &mut p,
+            &dhcp(false, &message(false, MessageType::Request, 42)),
+            false,
+            &None
+        ));
+        let mut m = message(true, MessageType::Ack, 42);
+        match mutation {
+            0 => {
+                m.opts_mut().insert(DhcpOption::ServerIdentifier(VM));
+            }
+            1 => {
+                m.set_chaddr(&HOST_MAC.0);
+            }
+            2 => {
+                m.set_giaddr(HOST);
+            }
+            3 => {
+                m.opts_mut().insert(DhcpOption::AddressLeaseTime(0));
+            }
+            _ => {
+                m.opts_mut()
+                    .insert(DhcpOption::ClientIdentifier(vec![1, 2, 3]));
+            }
+        }
+        assert!(!allowed(&mut p, &dhcp(true, &m), true, &None));
+    }
